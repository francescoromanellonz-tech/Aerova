VITE_CHECKOUT_WORKER_URL=https://pah-stripe-checkout.dario-930.workers.dev

# Gemini Nano Banana 2.0 (Gemini 3 Pro Image) — server-side only, never exposed to client.
# Rotate this key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyDBnroaf4F38iWfCT3X260MkRL3ja8HOL8
# Override if Google renames the model; defaults work for current Nano Banana 2.0.
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Mailchimp — server-side only, never exposed to client.
# API key format: {hash}-{server-prefix}, e.g. abc123-us3
# Server prefix is appended to api requests as https://{server}.api.mailchimp.com
# Rotate at https://admin.mailchimp.com/account/api/
MAILCHIMP_API_KEY=95b876555d8615b3ddfcb3cd5b0c5486-us3
MAILCHIMP_SERVER_PREFIX=us3
MAILCHIMP_AUDIENCE_ID=1f6b640634

# Cloudflare Worker URL that proxies Mailchimp Marketing API server-side.
# Leave blank to keep JSONP-only signups (still works). When set, the client
# calls this worker instead of JSONP for richer tagging and merge-field support.
# Deploy workers/mailchimp-subscribe/worker.js to your account, then paste the URL here.
VITE_MAILCHIMP_WORKER_URL=http://localhost:8787

# Vercel deployment token — server-side / CLI only, never exposed to client.
# Used by `vercel` CLI / CI for deployments. Rotate at https://vercel.com/account/tokens
VERCEL_TOKEN=vcp_7KRcx1yhKe3w18kBQ9SWgYjApQ5upqcUQ5Z1CU8z3YApnFhgCv4gc5FN

# Brevo (Sendinblue) — server-side only, never exposed to client.
# Used by scripts/create-brevo-templates.mjs and (planned) a Vercel /api/subscribe function.
# Rotate at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=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
# Base64-wrapped form Brevo also shows ({"api_key":"..."}); same secret, kept for reference.
BREVO_API_KEY_B64=eyJhcGlfa2V5IjoieGtleXNpYi1jN2FjMjQ1NWY5OTIwOGVlM2I3YzVjZWUxY2NmYjU1MzY4ZGNhYTFiNTRmZGJiOTQxODBiOTJkZGRlNmY3NzdjLXVEd1JZbmg2WlpleFpTMjUifQ==
# Brevo list the /api/subscribe function adds contacts to. 10 = "Aerova Newsletter".
BREVO_LIST_ID=10
# Contact form (/api/contact) — enquiry destination + sender. FROM must be a VERIFIED
# Brevo sender (currently only francescoromanellonz@gmail.com is verified; verify
# franc@aerova.vn in Brevo for branded sending, then switch CONTACT_FROM_EMAIL).
CONTACT_TO_EMAIL=francescoromanellonz@gmail.com
CONTACT_FROM_EMAIL=francescoromanellonz@gmail.com
CONTACT_FROM_NAME=AEROVA Website
# Brevo list /api/contact captures enquiries into. 11 = "Contact Enquiries".
BREVO_ENQUIRY_LIST_ID=11
# Brevo SMTP relay key (xsmtpsib-) — password for smtp-relay.brevo.com (login = account email).
# Only needed if /api/contact is switched from the REST API to SMTP-relay sending.
BREVO_SMTP_KEY=xsmtpsib-c7ac2455f99208ee3b7c5cee1ccfb55368dcaa1b54fdbb94180b92ddde6f777c-2iiUoDmgKnFniXkR
